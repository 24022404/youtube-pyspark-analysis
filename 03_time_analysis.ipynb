    "df = df.withColumn('trending_month', month('trending_date'))\n",
    "df = df.withColumn('trending_year', year('trending_date'))\n",
    "\n",
    "print(\" Time features extracted\")\n",
    "df.select('video_id', 'publishedAt', 'publish_hour', 'publish_day').show(5)"
