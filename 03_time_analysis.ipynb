    "# PHÂN TÍCH BỔ SUNG 1: TIME-TO-TREND THEO THỂ LOẠI\n",
    "# Mục đích: Xem thể loại nào \"bùng nổ\" nhanh nhất.\n",
    "\n",
    "print(\"PHÂN TÍCH BỔ SUNG: TIME-TO-TREND THEO THỂ LOẠI\")\n",
    "\n",
    "# df_first_trend đã được tạo ở Phân tích 4\n",
